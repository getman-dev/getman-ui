{
  "openapi": "3.1.0",
  "info": {
    "title": "Callbacks & Webhooks API",
    "description": "Demonstrates OpenAPI `callbacks` (server calls your URL after an async operation) and OpenAPI 3.1 top-level `webhooks` (server-initiated events your system must handle). Covers subscription management, callback URL registration, and event payload schemas.",
    "version": "1.0.0"
  },
  "servers": [{ "url": "https://api.example.com/v1" }],
  "tags": [
    { "name": "subscriptions", "description": "Subscribe to event callbacks" },
    { "name": "payments", "description": "Payment operations with async callbacks" },
    { "name": "exports", "description": "Async export jobs with completion callbacks" }
  ],
  "paths": {
    "/subscriptions": {
      "post": {
        "operationId": "createSubscription",
        "summary": "Subscribe to events",
        "description": "Register a callback URL to receive event notifications. The server will POST to your `callbackUrl` whenever a matching event occurs.",
        "tags": ["subscriptions"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SubscriptionRequest" },
              "example": {
                "callbackUrl": "https://yourapp.com/webhooks/events",
                "events": ["order.created", "order.shipped", "order.delivered"],
                "secret": "whsec_abc123"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Subscription created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Subscription" }
              }
            }
          }
        },
        "callbacks": {
          "onEvent": {
            "{$request.body#/callbackUrl}": {
              "post": {
                "summary": "Event notification delivery",
                "description": "The server POSTs this payload to your `callbackUrl` when a subscribed event fires. Verify the `X-Signature-256` header using your `secret`.",
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": { "$ref": "#/components/schemas/EventPayload" }
                    }
                  }
                },
                "parameters": [
                  {
                    "name": "X-Signature-256",
                    "in": "header",
                    "required": true,
                    "description": "HMAC-SHA256 of the raw request body, signed with your subscription secret",
                    "schema": { "type": "string", "example": "sha256=abc123def456..." }
                  },
                  {
                    "name": "X-Event-ID",
                    "in": "header",
                    "description": "Unique event ID for deduplication",
                    "schema": { "type": "string", "format": "uuid" }
                  },
                  {
                    "name": "X-Delivery-Attempt",
                    "in": "header",
                    "description": "Delivery attempt number (1 = first try)",
                    "schema": { "type": "integer", "minimum": 1 }
                  }
                ],
                "responses": {
                  "200": { "description": "Event acknowledged — no retry needed" },
                  "202": { "description": "Event accepted for async processing" },
                  "5XX": { "description": "Server error — delivery will be retried with exponential backoff" }
                }
              }
            }
          }
        }
      }
    },
    "/subscriptions/{subscriptionId}": {
      "parameters": [
        { "name": "subscriptionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "get": {
        "operationId": "getSubscription",
        "summary": "Get a subscription",
        "tags": ["subscriptions"],
        "responses": {
          "200": {
            "description": "Subscription details",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Subscription" } }
            }
          },
          "404": { "description": "Not found" }
        }
      },
      "delete": {
        "operationId": "deleteSubscription",
        "summary": "Cancel a subscription",
        "tags": ["subscriptions"],
        "responses": {
          "204": { "description": "Subscription cancelled" }
        }
      }
    },
    "/payments": {
      "post": {
        "operationId": "initiatePayment",
        "summary": "Initiate a payment (async with callback)",
        "description": "Starts a payment flow. Processing is asynchronous — your `callbackUrl` receives a `payment.completed` or `payment.failed` event when done.",
        "tags": ["payments"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PaymentRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Payment initiated, processing asynchronously",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/PaymentAccepted" } }
            }
          }
        },
        "callbacks": {
          "onPaymentResult": {
            "{$request.body#/callbackUrl}": {
              "post": {
                "summary": "Payment result callback",
                "description": "Called when payment processing completes (success or failure).",
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": { "$ref": "#/components/schemas/PaymentResultEvent" }
                    }
                  }
                },
                "responses": {
                  "200": { "description": "Result acknowledged" }
                }
              }
            }
          }
        }
      }
    },
    "/exports": {
      "post": {
        "operationId": "startExport",
        "summary": "Start a data export job (async with callback)",
        "description": "Starts an async export. When complete, the server POSTs the download URL to your `callbackUrl`.",
        "tags": ["exports"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ExportRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Export job queued",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ExportJob" } }
            }
          }
        },
        "callbacks": {
          "onExportComplete": {
            "{$request.body#/callbackUrl}": {
              "post": {
                "summary": "Export completion callback",
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": { "$ref": "#/components/schemas/ExportCompleteEvent" }
                    }
                  }
                },
                "responses": {
                  "200": { "description": "Callback received" }
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {
    "order.created": {
      "post": {
        "summary": "Order created webhook",
        "description": "Fired when a new order is placed in the system. Your registered webhook endpoint must handle this event.",
        "tags": ["subscriptions"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  { "$ref": "#/components/schemas/WebhookEnvelope" },
                  {
                    "type": "object",
                    "properties": {
                      "data": { "$ref": "#/components/schemas/OrderCreatedData" }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Webhook processed successfully" },
          "202": { "description": "Accepted for async processing" }
        }
      }
    },
    "order.shipped": {
      "post": {
        "summary": "Order shipped webhook",
        "description": "Fired when an order's shipment label is created and tracking number is assigned.",
        "tags": ["subscriptions"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  { "$ref": "#/components/schemas/WebhookEnvelope" },
                  {
                    "type": "object",
                    "properties": {
                      "data": { "$ref": "#/components/schemas/OrderShippedData" }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Webhook processed" }
        }
      }
    },
    "payment.completed": {
      "post": {
        "summary": "Payment completed webhook",
        "description": "Fired when a payment transaction is finalized (either succeeded or failed).",
        "tags": ["subscriptions"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  { "$ref": "#/components/schemas/WebhookEnvelope" },
                  {
                    "type": "object",
                    "properties": {
                      "data": { "$ref": "#/components/schemas/PaymentResultEvent" }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Webhook processed" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SubscriptionRequest": {
        "type": "object",
        "required": ["callbackUrl", "events"],
        "properties": {
          "callbackUrl": {
            "type": "string",
            "format": "uri",
            "description": "HTTPS URL that will receive event POST requests",
            "example": "https://yourapp.com/webhooks/events"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["order.created", "order.shipped", "order.delivered", "payment.completed", "payment.failed"]
            },
            "minItems": 1
          },
          "secret": {
            "type": "string",
            "writeOnly": true,
            "description": "Shared secret used to sign webhook payloads",
            "minLength": 16
          },
          "description": { "type": "string" }
        }
      },
      "Subscription": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid", "readOnly": true },
          "callbackUrl": { "type": "string", "format": "uri" },
          "events": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["active", "paused", "disabled"] },
          "createdAt": { "type": "string", "format": "date-time", "readOnly": true }
        }
      },
      "EventPayload": {
        "type": "object",
        "required": ["id", "type", "createdAt", "data"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "description": "Unique event ID — use for deduplication" },
          "type": { "type": "string", "example": "order.created" },
          "apiVersion": { "type": "string", "example": "2024-01-01" },
          "createdAt": { "type": "string", "format": "date-time" },
          "data": { "type": "object", "additionalProperties": true, "description": "Event-specific payload" }
        }
      },
      "WebhookEnvelope": {
        "type": "object",
        "required": ["id", "type", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "type": { "type": "string" },
          "apiVersion": { "type": "string", "example": "2024-01-01" },
          "createdAt": { "type": "string", "format": "date-time" },
          "data": { "type": "object" }
        }
      },
      "OrderCreatedData": {
        "type": "object",
        "properties": {
          "orderId": { "type": "string", "format": "uuid" },
          "customerId": { "type": "string", "format": "uuid" },
          "total": { "type": "number" },
          "currency": { "type": "string", "example": "USD" },
          "itemCount": { "type": "integer" }
        }
      },
      "OrderShippedData": {
        "type": "object",
        "properties": {
          "orderId": { "type": "string", "format": "uuid" },
          "trackingNumber": { "type": "string" },
          "carrier": { "type": "string", "example": "UPS" },
          "estimatedDelivery": { "type": "string", "format": "date" }
        }
      },
      "PaymentRequest": {
        "type": "object",
        "required": ["amount", "currency", "callbackUrl"],
        "properties": {
          "amount": { "type": "integer", "description": "Amount in smallest currency unit (e.g. cents)", "example": 2999 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "example": "USD" },
          "description": { "type": "string" },
          "callbackUrl": { "type": "string", "format": "uri" }
        }
      },
      "PaymentAccepted": {
        "type": "object",
        "properties": {
          "paymentId": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "const": "processing" },
          "callbackUrl": { "type": "string", "format": "uri" }
        }
      },
      "PaymentResultEvent": {
        "type": "object",
        "properties": {
          "paymentId": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["succeeded", "failed"] },
          "amount": { "type": "integer" },
          "currency": { "type": "string" },
          "failureReason": { "type": ["string", "null"] }
        }
      },
      "ExportRequest": {
        "type": "object",
        "required": ["format", "callbackUrl"],
        "properties": {
          "format": { "type": "string", "enum": ["csv", "json", "xlsx"] },
          "filters": { "type": "object", "additionalProperties": true },
          "callbackUrl": { "type": "string", "format": "uri" }
        }
      },
      "ExportJob": {
        "type": "object",
        "properties": {
          "jobId": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["queued", "processing"] },
          "estimatedSeconds": { "type": "integer" }
        }
      },
      "ExportCompleteEvent": {
        "type": "object",
        "properties": {
          "jobId": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["completed", "failed"] },
          "downloadUrl": { "type": ["string", "null"], "format": "uri" },
          "expiresAt": { "type": ["string", "null"], "format": "date-time" },
          "errorMessage": { "type": ["string", "null"] }
        }
      }
    }
  }
}